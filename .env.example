# api mode is unverified on this machine as of this plan (the panel.tapie.kr
# proxy / saved key may be dead) — Task 10 checks this directly and falls
# back to CLAUDE_AUTH_MODE=pro if it fails.
CLAUDE_AUTH_MODE=api
ANTHROPIC_API_KEY_SAVED=
ANA_WORKSPACE_DIR=/home/hello/workspace
# Optional: pin the CLI to a specific model/effort. Leave blank to let the
# claude CLI use its own defaults.
CLAUDE_MODEL=
CLAUDE_EFFORT=

# Set this when accessing the web UI from another device on the internal
# network (e.g. ws://192.168.1.20:8000/ws/chat or ws://<hostname>:8000/ws/chat).
# Leave blank to default to ws://localhost:8000/ws/chat (same-machine only).
NEXT_PUBLIC_WS_URL=

# Postgres (pgvector). DATABASE_URL below must match POSTGRES_PASSWORD when
# running via docker-compose; for local (non-docker) dev against a Postgres
# you run yourself, set DATABASE_URL directly and ignore POSTGRES_PASSWORD.
POSTGRES_PASSWORD=ana_dev_password
DATABASE_URL=postgresql://postgres:ana_dev_password@localhost:5432/ana
