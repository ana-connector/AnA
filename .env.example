# Copy to .env and fill in what you need: `cp .env.example .env`.
# docker-compose reads this file twice: as the server's env_file, and for
# ${VAR} substitution in docker-compose.yml. Variables the compose file sets
# under `environment:` (DATABASE_URL, ANA_WORKSPACE_DIR, ...) override what is
# written here, so those lines only matter for local (non-docker) dev.
# Every other tuning knob is listed in README.md.

# --- Agents ------------------------------------------------------------------
# `pro` runs the claude CLI on the subscription login in ~/.claude. `api` runs
# it on TAPIE_API_KEY. Unset means `api`, so keep `pro` unless you use TAPIE.
CLAUDE_AUTH_MODE=pro
# Optional pins. Unset = each CLI's own default.
# CLAUDE_MODEL=
# CLAUDE_EFFORT=
# CODEX_MODEL=
# CODEX_EFFORT=
# KIMI_MODEL=
# KIMI_EFFORT=
# CURSOR_MODEL=
# CURSOR_EXECUTABLE=agent
# read-only | workspace-write | danger-full-access. Leave unset under Docker:
# codex's bubblewrap sandbox cannot start inside a container.
# CODEX_SANDBOX=

# TAPIE, the fourth agent: the claude CLI on a metered key.
# Unset key = the agent is simply not registered.
# TAPIE_API_KEY=
# TAPIE_BASE_URL=https://panel.tapie.kr/api/claude-code

# --- Server ------------------------------------------------------------------
# Encrypts secrets stored from the /secrets page. Set it (`openssl rand -hex 32`):
# unset, every stored secret becomes unreadable after a restart.
ANA_SECRET_KEY=
# Directory the CLIs work in (local dev; compose sets its own).
# ANA_WORKSPACE_DIR=/path/to/workspace
# Absolute host path of this checkout, registered as the `ana-self` workspace.
# ANA_SELF_WORKSPACE=/path/to/ana
# Origins allowed to open /ws/chat. Add http://<lan-ip>:3005 to use the UI
# from another device; a missing origin closes the socket with 1008.
ANA_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# --- Web UI ------------------------------------------------------------------
# Unset = derive the WebSocket from the page's own host, on NEXT_PUBLIC_WS_PORT.
# NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_WS_PORT=8100

# --- Postgres (pgvector) -----------------------------------------------------
# Dev-only placeholder; change it if the machine is reachable by others.
POSTGRES_PASSWORD=ana_dev_password
# Local dev only: compose publishes Postgres on 127.0.0.1:15432 and hands the
# server container its own DATABASE_URL. Keep the password in sync.
DATABASE_URL=postgresql://postgres:ana_dev_password@127.0.0.1:15432/ana

# --- Discord approvals (optional) --------------------------------------------
# Unset token = the bridge never starts. Empty allowlist = nobody may answer.
# ANA_DISCORD_BOT_TOKEN=
# ANA_DISCORD_CHANNEL_ID=
# ANA_DISCORD_ALLOWED_USER_IDS=
# `off` stops posting the agent's final answer at the end of each turn.
# ANA_DISCORD_TURN_SUMMARIES=off

# --- Observability (optional; unset = dev placeholders) ----------------------
# GRAFANA_PASSWORD=
# LANGFUSE_USER_EMAIL=
# LANGFUSE_USER_PASSWORD=
# LANGFUSE_DB_PASSWORD=
